{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BackupSync",
  "version": "2.0.0",
  "identifier": "dev.alireza.backupsync",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BackupSync",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
